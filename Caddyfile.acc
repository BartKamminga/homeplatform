{
    auto_https off
    servers {
        # Verkeer via de cloudflared-tunnel komt binnen vanaf g5 (LAN); het echte bezoekers-IP staat in Cf-Connecting-IP.
        # Alleen die header: X-Forwarded-For kan de bezoeker zelf aanvullen.
        trusted_proxies static private_ranges
        client_ip_headers Cf-Connecting-IP
    }
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Microfoon (dontforget), Bluetooth (vbt) en bewegingssensoren (YouTube-embed) blijven toegestaan
        Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()"
        -Server
    }
}

:80 {
    import security_headers

    # acc.webheaven.nl staat via de tunnel op internet (item 1191). Toegestaan: het LAN, het thuis-IP
    # (allow/home.caddy, bijgehouden door scripts/acc-home-ip.sh op G4) en extra IP's uit ACC_ALLOWED_IPS
    # (spatiegescheiden, GitHub-variabele van de acceptance-environment).
    @allowed {
        client_ip private_ranges {$ACC_ALLOWED_IPS}
        import /etc/caddy/allow/*.caddy
    }

    handle @allowed {
        handle /api/* {
            reverse_proxy backend_acc:8000
        }

        # Publieke sleutels van onze eigen tokens (RS256, item 1271)
        handle /.well-known/jwks.json {
            reverse_proxy backend_acc:8000
        }

        handle /l/* {
            reverse_proxy backend_acc:8000
        }

        @sw path_regexp ^/[^/]+/sw\.js$
        handle @sw {
            root * /srv/www
            header Cache-Control "no-cache"
            file_server
        }

        handle /admin/* {
            root * /srv/www
            try_files {path} /admin/index.html
            file_server
        }

        handle /landing/* {
            root * /srv/www
            try_files {path} /landing/index.html
            file_server
        }

        handle /nkhockey/* {
            root * /srv/www
            try_files {path} /nkhockey/index.html
            file_server
        }

        handle /mixmusic/* {
            root * /srv/www
            try_files {path} /mixmusic/index.html
            file_server
        }

        handle /dontforget/* {
            root * /srv/www
            try_files {path} /dontforget/index.html
            file_server
        }

        handle /account/* {
            root * /srv/www
            try_files {path} /account/index.html
            file_server
        }

        handle /tournix/* {
            root * /srv/www
            try_files {path} /tournix/index.html
            file_server
        }

        handle /fiets/* {
            root * /srv/www
            try_files {path} /fiets/index.html
            file_server
        }
        handle /myhome/* {
            root * /srv/www
            try_files {path} /myhome/index.html
            file_server
        }

        handle /poulebord/* {
            root * /srv/www
            try_files {path} /poulebord/index.html
            file_server
        }

        handle /vbt/* {
            root * /srv/www
            try_files {path} /vbt/index.html
            file_server
        }

        handle /beatcrades/* {
            root * /srv/www
            try_files {path} /beatcrades/index.html
            file_server
        }

        handle /scrapster/* {
            root * /srv/www
            try_files {path} /scrapster/index.html
            file_server
        }

        handle /hockey-inside/* {
            root * /srv/www
            try_files {path} /hockey-inside/index.html
            file_server
        }

        handle /agent-control/* {
            root * /srv/www
            try_files {path} /agent-control/index.html
            file_server
        }

        handle /mindbox/* {
            root * /srv/www
            try_files {path} /mindbox/index.html
            file_server
        }

        handle /yearof-mo14/* {
            root * /srv/www
            try_files {path} /yearof-mo14/index.html
            file_server
        }

        # YearOf: presentatie- en roadmappagina (statisch, map op de server, zie publish-yearof.ps1), niet in zoekmachines
        redir /yearof /yearof/ 308
        handle /yearof/* {
            root * /srv/static
            header X-Robots-Tag "noindex, nofollow"
            try_files {path} {path}index.html /yearof/index.html
            file_server
        }

        handle /assets/* {
            root * /srv/www
            file_server
        }

        handle /favicon.svg {
            root * /srv/www
            file_server
        }

        handle / {
            root * /srv/www
            try_files {path} /landing/index.html
            file_server
        }

        respond 404
    }

    handle {
        header X-Robots-Tag "noindex, nofollow"
        respond "Acceptatie: geen toegang" 403
    }
}
