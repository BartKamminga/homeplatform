# Kopieer naar .env.claude-agent (niet in git) en vul in.
# Gebruik: docker compose --env-file .env.claude-agent -f docker-compose.claude-agent.yml up -d --build

# Long-lived token, lokaal gegenereerd via: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# SSH-vorm (past bij de deploy-key hieronder), niet https
CLAUDE_AGENT_REPO_URL=git@github.com:<org>/homeplatform.git
CLAUDE_AGENT_BRANCH=develop

CLAUDE_AGENT_GIT_USER_NAME=Claude Agent
CLAUDE_AGENT_GIT_USER_EMAIL=bart.kamminga@nipv.nl

# Deploy-key genereren (eenmalig, op de G4):
#   mkdir -p secrets
#   ssh-keygen -t ed25519 -f secrets/claude-agent-deploy-key -N "" -C "claude-agent@g4"
#   chmod 600 secrets/claude-agent-deploy-key
# Public key (secrets/claude-agent-deploy-key.pub) toevoegen als Deploy Key
# met write-access in GitHub: repo Settings > Deploy keys.
